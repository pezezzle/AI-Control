<Window x:Class="ComfyUIControl.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ComfyUI Control" Width="620" Height="420" MinWidth="620" MinHeight="420"
 ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
 Background="#101827" FontFamily="Segoe UI" Foreground="{StaticResource Text}" Icon="Assets/ComfyUI-Control.ico">
 <Grid Margin="28,22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal">
   <Image Source="Assets/ComfyUI-Control.png" Width="48" Height="48" Margin="0,1,14,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
   <StackPanel>
   <TextBlock Text="ComfyUI" FontSize="27" FontWeight="SemiBold"/>
   <TextBlock Text="Image and video generation on your PC" Foreground="#A7B6CC" Margin="0,4,0,0" FontSize="13"/>
   </StackPanel>
  </StackPanel>
  <Border Grid.Row="2" Background="{StaticResource Surface}" CornerRadius="12" Padding="19,16">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#A7B6CC" VerticalAlignment="Top" Margin="0,7,14,0"/>
    <StackPanel Grid.Column="1">
     <TextBlock x:Name="StatusText" Text="Checking status …" FontSize="19" FontWeight="SemiBold" AutomationProperties.Name="Server status"/>
     <TextBlock x:Name="DetailText" Text="Please wait a moment." Foreground="#A7B6CC" FontSize="13" Margin="0,7,0,0" TextWrapping="Wrap"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Button x:Name="StartButton" Content="Start" Click="Start_Click" Background="#247DDD" IsEnabled="False"/>
   <Button x:Name="BrowserButton" Grid.Column="2" Content="Open in browser" Click="Browser_Click" IsEnabled="False"/>
   <Button x:Name="StopButton" Grid.Column="4" Content="Stop" Click="Stop_Click" Background="#583341" IsEnabled="False"/>
  </Grid>
  <StackPanel Grid.Row="5" VerticalAlignment="Top" Margin="0,12,0,0">
   <TextBlock x:Name="NoticeText" Foreground="#F2B7BA" FontSize="12" TextWrapping="Wrap"/>
   <Button x:Name="LogButton" Content="Open log" Click="Log_Click" Visibility="Collapsed" HorizontalAlignment="Left" Padding="0,5" Background="Transparent" Foreground="#95C8FF" FontSize="12"/>
  </StackPanel>
  <TextBlock Grid.Row="6" Text="Closing the window leaves ComfyUI running." Foreground="#8F9FB7" FontSize="12"/>
 </Grid>
</Window>
