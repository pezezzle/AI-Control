<Window x:Class="ComfyUIControl.StopDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ComfyUI beenden" Width="510" SizeToContent="Height" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" Background="#101827" FontFamily="Segoe UI" Foreground="{StaticResource Text}" ShowInTaskbar="False">
 <StackPanel Margin="25">
  <TextBlock Text="ComfyUI beenden?" FontSize="23" FontWeight="SemiBold"/>
  <TextBlock x:Name="Explanation" Margin="0,15,0,20" TextWrapping="Wrap" FontSize="14" Foreground="#B7C5D8"/>
  <Button Content="Nach allen Aufträgen beenden" Background="#247DDD" Click="Wait_Click" Margin="0,0,0,10" IsDefault="True"/>
  <Button Content="Sofort beenden und abbrechen" Background="#583341" Click="Force_Click" Margin="0,0,0,10"/>
  <Button Content="Abbrechen" Click="Cancel_Click" IsCancel="True"/>
 </StackPanel>
</Window>
